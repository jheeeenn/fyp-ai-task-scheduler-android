<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsSectionHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/appColorTextSecondaryDark</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsSectionDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">?attr/appColorTextMutedDark</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_settings_card</item>
        <item name="android:hapticFeedbackEnabled">true</item>
        <item name="android:minHeight">96dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="SettingsTechnicalCard" parent="SettingsCard">
        <item name="android:background">@drawable/bg_settings_card</item>
    </style>

    <style name="SettingsTitleText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/appColorTextPrimaryLight</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsDescriptionText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">?attr/appColorTextSecondaryLight</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsValueText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">?attr/appColorTextSecondaryLight</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsTechnicalValueText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:breakStrategy">simple</item>
        <item name="android:textColor">?attr/appColorTextSecondaryLight</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsTechnicalTitleText" parent="SettingsTitleText">
        <item name="android:textColor">?attr/appColorTextPrimaryLight</item>
    </style>

    <style name="SettingsSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">?attr/appColorTextPrimaryLight</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
