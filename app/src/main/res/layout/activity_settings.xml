<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appColorBackgroundPrimary"
    android:padding="16dp"
    tools:ignore="Overdraw">

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="14dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/settingsBottomDock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tvSettingsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings"
                android:textColor="?attr/appColorTextPrimaryDark"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAssistantPreferencesHeading"
                style="@style/SettingsSectionHeading"
                android:layout_marginTop="22dp"
                android:text="@string/assistant_preferences" />

            <LinearLayout
                android:id="@+id/cardTone"
                style="@style/SettingsCard"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingsTitleText" android:text="@string/assistant_tone" />
                <TextView android:id="@+id/tvToneValue" style="@style/SettingsValueText" tools:text="Friendly" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardReplyLength"
                style="@style/SettingsCard"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingsTitleText" android:text="@string/reply_length" />
                <TextView android:id="@+id/tvReplyLengthValue" style="@style/SettingsValueText" tools:text="Normal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSpeechSpeed"
                style="@style/SettingsCard"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingsTitleText" android:text="@string/speech_speed" />
                <TextView android:id="@+id/tvSpeechSpeedValue" style="@style/SettingsValueText" tools:text="Normal" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAccessibilityHeading"
                style="@style/SettingsSectionHeading"
                android:layout_marginTop="24dp"
                android:text="@string/accessibility_settings_heading" />

            <LinearLayout
                android:id="@+id/cardLargeText"
                style="@style/SettingsCard"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingsTitleText" android:text="@string/large_text" />
                <TextView android:id="@+id/tvLargeTextValue" style="@style/SettingsValueText" tools:text="Off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardHighContrast"
                style="@style/SettingsCard"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingsTitleText" android:text="@string/high_contrast" />
                <TextView android:id="@+id/tvHighContrastValue" style="@style/SettingsValueText" tools:text="Off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardProcessingHaptic"
                style="@style/SettingsCard"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingsTitleText" android:text="@string/processing_haptic_feedback" />
                <TextView android:id="@+id/tvProcessingHapticValue" style="@style/SettingsValueText" tools:text="On" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSessionEndHaptic"
                style="@style/SettingsCard"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingsTitleText" android:text="@string/session_end_haptic_feedback" />
                <TextView android:id="@+id/tvSessionEndHapticValue" style="@style/SettingsValueText" tools:text="On" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAdvancedSettings"
                style="@style/SettingsCard"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_settings_advanced_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">
                <TextView style="@style/SettingsTitleText" android:text="@string/advanced_settings" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/settingsBottomDock"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/btnGoHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_task_list_home_action"
            android:backgroundTint="@null"
            android:minHeight="108dp"
            android:text="@string/home"
            android:textAllCaps="false"
            android:textColor="?attr/appColorTaskListTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnTalkAssistant"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="2"
            android:background="@drawable/bg_task_list_assistant_action"
            android:backgroundTint="@null"
            android:hapticFeedbackEnabled="true"
            android:minHeight="108dp"
            android:text="@string/talk_to_assistant"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
