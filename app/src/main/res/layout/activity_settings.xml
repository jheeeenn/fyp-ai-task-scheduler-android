<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appColorBackgroundPrimary"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnGoHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvSettingsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings"
                android:textColor="?attr/appColorTextPrimaryDark"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAssistantPreferencesHeading"
                style="@style/SettingsSectionHeading"
                android:layout_marginTop="22dp"
                android:text="@string/assistant_preferences" />

            <LinearLayout
                android:id="@+id/cardTone"
                style="@style/SettingsCard"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsTitleText"
                    android:text="@string/assistant_tone" />

                <TextView
                    style="@style/SettingsDescriptionText"
                    android:text="@string/assistant_tone_description" />

                <TextView
                    android:id="@+id/tvToneValue"
                    style="@style/SettingsValueText"
                    tools:text="Friendly" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardReplyLength"
                style="@style/SettingsCard"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsTitleText"
                    android:text="@string/reply_length" />

                <TextView
                    style="@style/SettingsDescriptionText"
                    android:text="@string/reply_length_description" />

                <TextView
                    android:id="@+id/tvReplyLengthValue"
                    style="@style/SettingsValueText"
                    tools:text="Normal" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAccessibilityHeading"
                style="@style/SettingsSectionHeading"
                android:layout_marginTop="24dp"
                android:text="@string/accessibility_settings_heading" />

            <LinearLayout
                android:id="@+id/cardLargeText"
                style="@style/SettingsCard">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchLargeText"
                    style="@style/SettingsSwitch"
                    android:text="@string/large_text" />

                <TextView
                    style="@style/SettingsDescriptionText"
                    android:importantForAccessibility="no"
                    android:text="@string/large_text_description" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardHighContrast"
                style="@style/SettingsCard">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHighContrast"
                    style="@style/SettingsSwitch"
                    android:text="@string/high_contrast" />

                <TextView
                    style="@style/SettingsDescriptionText"
                    android:importantForAccessibility="no"
                    android:text="@string/high_contrast_description" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardProcessingHaptic"
                style="@style/SettingsCard">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchProcessingHaptic"
                    style="@style/SettingsSwitch"
                    android:text="@string/processing_haptic_feedback" />

                <TextView
                    style="@style/SettingsDescriptionText"
                    android:importantForAccessibility="no"
                    android:text="@string/processing_haptic_description" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSessionEndHaptic"
                style="@style/SettingsCard">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSessionEndHaptic"
                    style="@style/SettingsSwitch"
                    android:text="@string/session_end_haptic_feedback" />

                <TextView
                    style="@style/SettingsDescriptionText"
                    android:importantForAccessibility="no"
                    android:text="@string/session_end_haptic_description" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeveloperHeading"
                style="@style/SettingsSectionHeading"
                android:layout_marginTop="24dp"
                android:text="@string/developer_connection_heading" />

            <TextView
                style="@style/SettingsSectionDescription"
                android:text="@string/developer_connection_description" />

            <LinearLayout
                android:id="@+id/cardConversationAgentEndpoint"
                style="@style/SettingsTechnicalCard"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsTechnicalTitleText"
                    android:text="@string/conversation_agent_endpoint" />

                <TextView
                    android:id="@+id/tvConversationAgentEndpointValue"
                    style="@style/SettingsTechnicalValueText"
                    tools:text="http://192.168.0.132:1234/v1/chat/completions" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTaskAgentEndpoint"
                style="@style/SettingsTechnicalCard"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/SettingsTechnicalTitleText"
                    android:text="@string/task_agent_endpoint" />

                <TextView
                    android:id="@+id/tvTaskAgentEndpointValue"
                    style="@style/SettingsTechnicalValueText"
                    tools:text="http://192.168.0.132:1234/v1/chat/completions" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGoHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_anchor_home_button"
        android:backgroundTint="@null"
        android:minHeight="66dp"
        android:paddingVertical="12dp"
        android:text="@string/home"
        android:textAllCaps="false"
        android:textColor="?attr/appColorTextPrimaryDark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btnTalkAssistant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTalkAssistant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_anchor_assistant_button"
        android:backgroundTint="@null"
        android:hapticFeedbackEnabled="true"
        android:minHeight="104dp"
        android:paddingVertical="16dp"
        android:text="@string/talk_to_assistant"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
