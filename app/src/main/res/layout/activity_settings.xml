<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_primary"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnGoHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvSettingsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:layout_marginTop="4dp"
                android:text="Settings"
                android:textColor="@color/ui_text_primary_dark"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardTone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_task_card"
                android:clickable="true"
                android:contentDescription="Assistant tone setting"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:minHeight="96dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvToneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Assistant Tone"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvToneValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Friendly"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardReplyLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_task_card"
                android:clickable="true"
                android:contentDescription="Assistant reply length setting"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:minHeight="96dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvReplyLengthTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reply Length"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReplyLengthValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Normal"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardLargeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_task_card"
                android:clickable="true"
                android:contentDescription="Large text accessibility setting"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:minHeight="96dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvLargeTextTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Large Text"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLargeTextValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Off"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardHighContrast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_task_card"
                android:clickable="true"
                android:contentDescription="High contrast accessibility setting"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:minHeight="96dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvHighContrastTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="High Contrast"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHighContrastValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Off"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardProcessingHaptic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_task_card"
                android:clickable="true"
                android:contentDescription="@string/processing_haptic_feedback_on_description"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:minHeight="96dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvProcessingHapticTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/processing_haptic_feedback"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProcessingHapticValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setting_on"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardConversationAgentEndpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_task_card"
                android:clickable="true"
                android:contentDescription="Conversation agent LM Studio endpoint setting"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:minHeight="96dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvConversationAgentEndpointTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Conversation Agent Endpoint"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConversationAgentEndpointValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="http://192.168.0.132:1234/v1/chat/completions"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTaskAgentEndpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_task_card"
                android:clickable="true"
                android:contentDescription="Task agent LM Studio endpoint setting"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:minHeight="96dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTaskAgentEndpointTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Task Agent Endpoint"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTaskAgentEndpointValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="http://192.168.0.132:1234/v1/chat/completions"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="18sp" />
            </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGoHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_anchor_home_button"
        android:backgroundTint="@null"
        android:minHeight="66dp"
        android:paddingVertical="12dp"
        android:text="Home"
        android:textAllCaps="false"
        android:textColor="@color/ui_text_primary_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btnTalkAssistant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTalkAssistant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_anchor_assistant_button"
        android:backgroundTint="@null"
        android:hapticFeedbackEnabled="true"
        android:minHeight="104dp"
        android:paddingVertical="16dp"
        android:text="Talk to Assistant"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
