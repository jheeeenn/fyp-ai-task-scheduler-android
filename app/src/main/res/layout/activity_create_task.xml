<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/createTaskRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_primary"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/createScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnGoHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvCreateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Create Task"
                android:textColor="@color/ui_text_primary_dark"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCreateHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enter a task title, then choose date and time for your reminder."
                android:textColor="@color/ui_text_secondary_dark"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/etTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_input_field"
                android:hint="Task title"
                android:inputType="textCapSentences"
                android:minHeight="64dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textColor="@color/ui_text_primary_dark"
                android:textColorHint="@color/ui_text_muted_dark"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvDateSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Date"
                android:textColor="@color/ui_text_primary_dark"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_info_panel"
                android:padding="14dp"
                android:text="No date selected"
                android:textColor="@color/ui_text_secondary_dark"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnPickDate"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_create_button"
                android:backgroundTint="@null"
                android:text="Select Date"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_light"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/tvTimeSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Time"
                android:textColor="@color/ui_text_primary_dark"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_info_panel"
                android:padding="14dp"
                android:text="No time selected"
                android:textColor="@color/ui_text_secondary_dark"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnPickTime"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_create_button"
                android:backgroundTint="@null"
                android:text="Select Time"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_light"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnSaveTask"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_anchor_assistant_button"
                android:backgroundTint="@null"
                android:text="Save Task"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnCancelTask"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_action_button_disabled"
                android:backgroundTint="@null"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_dark"
                android:textSize="19sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGoHome"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_anchor_home_button"
        android:backgroundTint="@null"
        android:text="Home"
        android:textAllCaps="false"
        android:textColor="@color/ui_text_primary_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btnTalkAssistant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTalkAssistant"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@drawable/bg_anchor_assistant_button"
        android:backgroundTint="@null"
        android:text="Talk to Assistant"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
