<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_task_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/taskText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="Task title"
        android:textColor="@color/ui_text_primary_light"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/taskDateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="08/03/2026"
        android:textColor="@color/ui_text_secondary_light"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/taskTimeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="3:59 PM"
        android:textColor="@color/ui_text_secondary_light"
        android:textSize="19sp" />


    <TextView
        android:id="@+id/taskSubtaskSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Subtasks: 0 of 0 completed"
        android:textColor="@color/ui_text_secondary_light"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/taskSubtaskTitlesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="Subtask titles"
        android:textColor="@color/ui_text_secondary_light"
        android:textSize="17sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/taskStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Upcoming"
        android:textColor="@color/ui_accent_primary_dark"
        android:textSize="19sp"
        android:textStyle="bold" />

</LinearLayout>
