<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_task_status_unscheduled"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:hapticFeedbackEnabled="true"
    android:importantForAccessibility="yes"
    android:minHeight="96dp"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <TextView
        android:id="@+id/taskText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:lineSpacingExtra="2dp"
        android:text="@string/untitled_task"
        android:textColor="?attr/appColorTextPrimaryLight"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/taskStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:lineSpacingExtra="2dp"
        android:text="@string/task_status_preview"
        android:textColor="@color/task_status_unscheduled_text"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
