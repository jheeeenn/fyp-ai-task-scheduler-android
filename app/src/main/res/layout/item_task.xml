<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_task_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/taskText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task title"
        android:textColor="#1D1333"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/taskDateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="08/03/2026"
        android:textColor="#4F3D72"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/taskTimeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="3:59 PM"
        android:textColor="#4F3D72"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/taskStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Upcoming"
        android:textColor="#6C4BC3"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>