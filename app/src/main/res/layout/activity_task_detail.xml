<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_primary"
    android:padding="16dp"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/taskDetailHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/task_details_title"
        android:textColor="@color/ui_text_primary_dark"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UnusedAttribute" />

    <ScrollView
        android:id="@+id/taskDetailScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/detailActionGrid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/taskDetailHeading">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <LinearLayout
                android:id="@+id/detailTitleSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_panel"
                android:clickable="true"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:importantForAccessibility="yes"
                android:minHeight="88dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/detail_title_label"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:text="@string/untitled_task"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detailStatusSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_task_status_unscheduled"
                android:clickable="true"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:importantForAccessibility="yes"
                android:minHeight="88dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/detail_status_label"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:text="@string/unscheduled"
                    android:textColor="@color/task_status_unscheduled_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detailDateSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_panel"
                android:clickable="true"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:importantForAccessibility="yes"
                android:minHeight="82dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/detail_due_date_label"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailDateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:text="@string/no_date_set"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="21sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detailTimeSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_panel"
                android:clickable="true"
                android:focusable="true"
                android:hapticFeedbackEnabled="true"
                android:importantForAccessibility="yes"
                android:minHeight="82dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/detail_due_time_label"
                    android:textColor="@color/ui_text_secondary_light"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:text="@string/no_time_set"
                    android:textColor="@color/ui_text_primary_light"
                    android:textSize="21sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detailSubtasksSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/detail_subtasks_label"
                    android:textColor="@color/ui_text_primary_dark"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:ignore="UnusedAttribute" />

                <LinearLayout
                    android:id="@+id/detailSubtaskProgressSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_info_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:hapticFeedbackEnabled="true"
                    android:importantForAccessibility="yes"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/detail_progress_label"
                        android:textColor="@color/ui_text_secondary_light"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailSubtaskProgressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:importantForAccessibility="no"
                        android:text="@string/no_subtasks"
                        android:textColor="@color/ui_text_primary_light"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detailSubtaskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/detailActionGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/btnGoHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ButtonStyle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReadAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_action_button"
                android:backgroundTint="@null"
                android:minHeight="64dp"
                android:text="@string/read_all"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_light"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnToggleDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_action_button"
                android:backgroundTint="@null"
                android:minHeight="64dp"
                android:text="@string/mark_done"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_light"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditTask"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_action_button"
                android:backgroundTint="@null"
                android:minHeight="64dp"
                android:text="@string/edit"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_light"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnDeleteTask"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_action_button"
                android:backgroundTint="@null"
                android:minHeight="64dp"
                android:text="@string/delete"
                android:textAllCaps="false"
                android:textColor="@color/ui_danger"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnGoHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_anchor_home_button"
        android:backgroundTint="@null"
        android:minHeight="60dp"
        android:text="@string/home"
        android:textAllCaps="false"
        android:textColor="@color/ui_text_primary_dark"
        android:textSize="19sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btnTalkAssistant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTalkAssistant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_anchor_assistant_button"
        android:backgroundTint="@null"
        android:hapticFeedbackEnabled="true"
        android:minHeight="88dp"
        android:text="@string/talk_to_assistant"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="23sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
