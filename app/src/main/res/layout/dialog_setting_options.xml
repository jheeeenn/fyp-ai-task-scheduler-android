<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ui_bg_secondary"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Option"
        android:textColor="@color/ui_text_primary_dark"
        android:textSize="25sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioGroupOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />

    <Button
        android:id="@+id/btnDialogSave"
        android:contentDescription="Save selected setting option"
        android:hapticFeedbackEnabled="true"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_create_button"
        android:backgroundTint="@null"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="@color/ui_text_primary_light"
        android:textSize="19sp"
        android:textStyle="bold" />
</LinearLayout>
