<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appColorBackgroundPrimary"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDeveloperTestTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/developer_test_title"
        android:textColor="?attr/appColorTextPrimaryDark"
        android:textSize="28sp"
        android:textStyle="bold" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchDeveloperTestTts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:checked="false"
        android:minHeight="48dp"
        android:text="@string/developer_test_tts"
        android:textColor="?attr/appColorTextPrimaryDark"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvDeveloperTestStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/developer_test_ready"
        android:textColor="?attr/appColorTextSecondaryDark"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/developerTranscriptScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_task_detail_action_save_dirty"
        android:fillViewport="true"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/developerTranscriptContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etDeveloperTestInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/developer_test_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="56dp"
            android:padding="12dp"
            android:textColor="?attr/appColorTextPrimaryDark"
            android:textColorHint="?attr/appColorTextMutedDark" />

        <Button
            android:id="@+id/btnDeveloperTestSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="56dp"
            android:text="@string/developer_test_send"
            android:textAllCaps="false"
            app:backgroundTint="?attr/appColorAccentPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDeveloperTestReset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:text="@string/developer_test_reset"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnDeveloperTestBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:text="@string/developer_test_back"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
