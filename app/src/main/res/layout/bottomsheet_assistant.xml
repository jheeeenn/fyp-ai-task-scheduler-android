<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistantPanelScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:id="@+id/assistantRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_assistant_panel"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/stateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_assistant_state_container"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/assistantStateIndicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_assistant_state_indicator"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvAssistantState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="@string/assistant_ready"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/assistantTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:importantForAccessibility="no"
                android:text="@string/assistant_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/userTranscriptSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvUserLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/assistant_user_label"
                android:textAllCaps="true"
                android:textColor="?attr/appColorTextMutedDark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserSpeech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="yes"
                android:lineSpacingExtra="4dp"
                android:text=""
                android:textColor="?attr/appColorTextPrimaryDark"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/assistantReplySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAssistantLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/assistant_reply_label"
                android:textAllCaps="true"
                android:textColor="?attr/appColorTextMutedDark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAssistantReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="yes"
                android:lineSpacingExtra="4dp"
                android:text=""
                android:textColor="?attr/appColorTextPrimaryDark"
                android:textSize="21sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
