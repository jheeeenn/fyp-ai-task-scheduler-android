<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editTaskRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_primary"
    android:padding="16dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/editHalfGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.52" />

    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_section_panel"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toTopOf="@id/editHalfGuide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvEditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Task"
            android:textColor="@color/ui_text_primary_dark"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEditHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="Review details above, then use the controls below to update the reminder."
            android:textColor="@color/ui_text_secondary_dark"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="Task title"
            android:inputType="textCapSentences"
            android:minHeight="64dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="@color/ui_text_primary_dark"
            android:textColorHint="@color/ui_text_muted_dark"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvDateSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Selected Date"
            android:textColor="@color/ui_text_muted_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_info_panel"
            android:padding="14dp"
            android:text="No date selected"
            android:textColor="@color/ui_text_primary_dark"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTimeSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Selected Time"
            android:textColor="@color/ui_text_muted_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_info_panel"
            android:padding="14dp"
            android:text="No time selected"
            android:textColor="@color/ui_text_primary_dark"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/btnGoHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editHalfGuide">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickDate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_create_button"
                android:backgroundTint="@null"
                android:text="Change Date"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_light"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnPickTime"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_create_button"
                android:backgroundTint="@null"
                android:text="Change Time"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_light"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveTask"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_anchor_assistant_button"
            android:backgroundTint="@null"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDeleteTask"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_action_button"
                android:backgroundTint="@null"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="@color/ui_danger"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnCancelTask"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_action_button_disabled"
                android:backgroundTint="@null"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnGoHome"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_anchor_home_button"
        android:backgroundTint="@null"
        android:text="Home"
        android:textAllCaps="false"
        android:textColor="@color/ui_text_primary_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btnTalkAssistant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTalkAssistant"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@drawable/bg_anchor_assistant_button"
        android:backgroundTint="@null"
        android:text="Talk to Assistant"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
