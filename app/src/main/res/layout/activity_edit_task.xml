<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editTaskRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_primary"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/editScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnGoHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvEditTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Edit Task"
                android:textColor="@color/ui_text_primary_dark"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTaskTitleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/etTaskTitle"
                android:text="@string/task_title_label"
                android:textColor="@color/ui_text_primary_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:inputType="textCapSentences"
                android:minHeight="72dp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp"
                android:textColor="@color/ui_text_primary_dark"
                android:textColorHint="@color/ui_text_muted_dark"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/dateInfoGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:importantForAccessibility="yes"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDateSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="Date"
                    android:textColor="@color/ui_text_primary_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_info_panel"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:text="No date selected"
                    android:textColor="@color/ui_text_primary_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPickDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_create_button"
                android:backgroundTint="@null"
                android:hapticFeedbackEnabled="true"
                android:minHeight="70dp"
                android:paddingVertical="14dp"
                android:text="Change Date"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_light"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <LinearLayout
                android:id="@+id/timeInfoGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:importantForAccessibility="yes"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTimeSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="Time"
                    android:textColor="@color/ui_text_primary_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_info_panel"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:text="No time selected"
                    android:textColor="@color/ui_text_primary_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPickTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_create_button"
                android:backgroundTint="@null"
                android:hapticFeedbackEnabled="true"
                android:minHeight="70dp"
                android:paddingVertical="14dp"
                android:text="Change Time"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_light"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnSaveTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_anchor_assistant_button"
                android:backgroundTint="@null"
                android:hapticFeedbackEnabled="true"
                android:minHeight="72dp"
                android:paddingVertical="14dp"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnDeleteTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_action_button"
                android:backgroundTint="@null"
                android:hapticFeedbackEnabled="true"
                android:minHeight="68dp"
                android:paddingVertical="14dp"
                android:text="Delete Task"
                android:textAllCaps="false"
                android:textColor="@color/ui_danger"
                android:textSize="21sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnCancelTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_action_button_disabled"
                android:backgroundTint="@null"
                android:minHeight="68dp"
                android:paddingVertical="14dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_primary_dark"
                android:textSize="21sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGoHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_anchor_home_button"
        android:backgroundTint="@null"
        android:minHeight="66dp"
        android:paddingVertical="12dp"
        android:text="Home"
        android:textAllCaps="false"
        android:textColor="@color/ui_text_primary_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btnTalkAssistant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTalkAssistant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_anchor_assistant_button"
        android:backgroundTint="@null"
        android:hapticFeedbackEnabled="true"
        android:minHeight="104dp"
        android:paddingVertical="16dp"
        android:text="Talk to Assistant"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
