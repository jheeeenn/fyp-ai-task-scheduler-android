<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/taskListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_primary"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="Scheduled Tasks"
        android:textColor="@color/ui_text_primary_dark"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/taskListSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/scheduled_task_count_empty"
        android:textColor="@color/ui_text_secondary_dark"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/taskRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_section_panel"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/taskActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/taskListSummary" />

    <TextView
        android:id="@+id/emptyTaskText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:text="@string/no_scheduled_tasks"
        android:textColor="@color/ui_text_secondary_dark"
        android:textSize="22sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/taskRecyclerView"
        app:layout_constraintEnd_toEndOf="@id/taskRecyclerView"
        app:layout_constraintStart_toStartOf="@id/taskRecyclerView"
        app:layout_constraintTop_toTopOf="@id/taskRecyclerView" />

    <HorizontalScrollView
        android:id="@+id/taskActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnCreateNewTask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

        <Button
            android:id="@+id/btnTaskDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_action_button"
            android:backgroundTint="@null"
            android:hapticFeedbackEnabled="true"
            android:minHeight="72dp"
            android:minWidth="108dp"
            android:paddingVertical="12dp"
            android:text="Done"
            android:textAllCaps="false"
            android:textColor="@color/ui_text_primary_light"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnTaskEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_action_button"
            android:backgroundTint="@null"
            android:hapticFeedbackEnabled="true"
            android:minHeight="72dp"
            android:minWidth="108dp"
            android:paddingVertical="12dp"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="@color/ui_text_primary_light"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnTaskDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_action_button"
            android:backgroundTint="@null"
            android:hapticFeedbackEnabled="true"
            android:minHeight="72dp"
            android:minWidth="108dp"
            android:paddingVertical="12dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="@color/ui_danger"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnCreateNewTask"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_create_button"
        android:backgroundTint="@null"
        android:hapticFeedbackEnabled="true"
        android:minHeight="70dp"
        android:paddingVertical="14dp"
        android:text="Create New Task"
        android:textAllCaps="false"
        android:textColor="@color/ui_text_primary_light"
        android:textSize="22sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btnGoHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnGoHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_anchor_home_button"
        android:backgroundTint="@null"
        android:minHeight="66dp"
        android:paddingVertical="12dp"
        android:text="Home"
        android:textAllCaps="false"
        android:textColor="@color/ui_text_primary_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btnTalkAssistant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTalkAssistant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_anchor_assistant_button"
        android:backgroundTint="@null"
        android:hapticFeedbackEnabled="true"
        android:minHeight="104dp"
        android:paddingVertical="16dp"
        android:text="Talk to Assistant"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
